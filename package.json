    "audit:verify": "node scripts/verify-audit.mjs",
    "prepublishOnly": "node scripts/verify-publish.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "search-boost-keys.example.json",
    "README.md",
    "README_zh.md",
    "install.sh",
    "install.ps1",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "x-search",
    "twitter",
    "guest-graphql",
    "oembed",
    "search",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-remon219/dsh-search-boost.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {}
